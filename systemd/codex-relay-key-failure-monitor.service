[Unit]
Description=Quarantine failed Codex relay keys from Nginx responses
After=codex-relay-nginx.service
Requires=codex-relay-nginx.service

[Service]
Type=simple
ExecStart=/bin/bash %h/.local/share/codex-relay/codex-relay-key-failure-monitor.sh
Restart=always
RestartSec=2
UMask=0077
MemoryMax=32M
CPUQuota=10%
TasksMax=64
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/codex-relay/nginx

[Install]
WantedBy=default.target
