# Default deny: only explicitly listed reference source files may be committed.
*
!.gitignore
!README.md
!install.py
!tests/
tests/*
!tests/test_install.py
!tests/test_routes.py
!tests/linux_integration.py
!tests/Dockerfile
!.github/
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/linux-integration.yml
!server/
server/*
!server/dashboard_remote.py
!server/route-lib.sh
!server/probe-upstream-keys.sh
!server/rotate-upstream-auth.sh
!server/quarantine-current-key.sh
!server/codex-relay-key-failure-monitor.sh
!nginx/
nginx/*
!nginx/nginx.conf
!systemd/
systemd/*
!systemd/codex-relay-nginx.service
!systemd/codex-relay-key-probe.service
!systemd/codex-relay-key-probe.timer
!systemd/codex-relay-key-rotate.service
